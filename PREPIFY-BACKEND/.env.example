PORT=5000

# MongoDB connection string. MONGODB_DB overrides the database name in the URI (optional).
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_DB=prepify

# Long random strings, different from each other.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Comma-separated list of frontend origins allowed by CORS.
CORS_ORIGINS=http://localhost:5173,https://prepify-chi.vercel.app

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to true to use canned AI responses (no Gemini key needed). Dev/testing only.
AI_MOCK=false
